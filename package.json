{
  "name": "auditfix",
  "version": "1.2.0",
  "description": "Smarter npm dependency security CLI — production reachability, actionable fixes, noise-free reports",
  "type": "module",
  "bin": {
    "auditfix": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BFAlajid/auditfix.git"
  },
  "homepage": "https://github.com/BFAlajid/auditfix",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.1",
    "lilconfig": "^3.1.3",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.0",
    "@types/semver": "^7.5.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "data"
  ],
  "license": "MIT",
  "keywords": [
    "npm",
    "audit",
    "security",
    "vulnerability",
    "dependency"
  ]
}
